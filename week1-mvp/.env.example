# ==========================================
# 服装AI生图工具 - 环境变量
# ==========================================
# 部署到服务器时，把这个文件复制为 .env 并填入真实值
# 命令: cp .env.example .env
#
# 鉴权方式：Application Default Credentials (ADC)
# 两种来源：
#   A. VM 绑定的 Service Account（部署在 GCP VM 的标准做法）
#   B. 用户账号 gcloud auth application-default login 生成的凭证
#      （当 SA 没有某些 preview 模型访问权时用 B 兜底）
# ==========================================

# Google Cloud 项目 ID（必填）
# 从 GCP 控制台顶部的项目选择器里复制（不是项目名，是下方的 ID）
# 例如：buqiqi-batch-image-tool
GCP_PROJECT_ID=

# ADC 凭证文件路径（可选）
# 留空 = 容器内走 VM 的 Service Account 鉴权（默认，适合大多数 GA 模型）
# 填 /app/gcp-credentials/application_default_credentials.json
#   = 使用用户账号 ADC（需要先 gcloud auth application-default login 生成
#     ~/.config/gcloud/application_default_credentials.json 并放到
#     ./gcp-credentials/ 目录）
# 场景：SA 没有某些 preview 模型（如 Nano Banana）访问权时，用用户账号绕过
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI 所在区域（推荐和 VM 同区域以降低延迟）
# 支持 Gemini 的区域：asia-southeast1(新加坡)、asia-east1(台湾)、
# asia-northeast1(东京)、us-central1、europe-west1 等
GCP_LOCATION=asia-southeast1

# 域名（例如 ai-tool.yourdomain.com）
# 必须已经解析到 VM 的公网 IP
DOMAIN=

# Caddy 自动申请 HTTPS 证书时用的邮箱
# 填你能收邮件的邮箱，Let's Encrypt 会发送证书过期提醒
ADMIN_EMAIL=admin@example.com

# ==========================================
# Week 2 新增：账号登录相关
# ==========================================

# 会话加密密钥，至少 32 个字符
# 生成方法（在 SSH 终端里跑）：openssl rand -hex 32
# 这个值泄露后所有登录会话都会失效（需要重新登录），注意保密
SESSION_SECRET=

# 首次启动时自动创建的管理员账号（如果数据库里还没有任何用户）
# 建议先用强密码，登录后在"用户管理"页面改密码或加新成员
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
