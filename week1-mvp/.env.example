# ==========================================
# 伴娘服 AI 工具 - 环境变量
# ==========================================
# 部署到服务器时，把这个文件复制为 .env 并填入真实值
# 命令: cp .env.example .env
#
# 鉴权方式：Application Default Credentials (ADC)
# 不需要 API Key，VM 会通过绑定的 Service Account 自动向 Vertex AI 鉴权
# 前提是：VM 的 Service Account 拥有 "Vertex AI User" 角色
# ==========================================

# Google Cloud 项目 ID
# 从 GCP 控制台顶部的项目选择器里复制（不是项目名，是下方的 ID）
# 例如：buqiqi-batch-image-tool
GCP_PROJECT_ID=

# Vertex AI 所在区域（推荐和 VM 同区域以降低延迟）
# 支持 Gemini 的区域：asia-southeast1(新加坡)、asia-east1(台湾)、
# asia-northeast1(东京)、us-central1、europe-west1 等
GCP_LOCATION=asia-southeast1

# Nano Banana 图像生成模型名（可选）
# 留空 = 使用默认 gemini-3-pro-image-preview（Nano Banana Pro，质量最高）
#
# 命名对照：
#   gemini-3-pro-image-preview      = Nano Banana Pro（2 代，推荐）
#   gemini-2.5-flash-image-preview  = Nano Banana（初代 preview）
#   gemini-2.5-flash-image          = Nano Banana（初代 GA，部分区域可用）
#
# 注：用户在 /recolor 页可以临时切换模型，这里只是"全局默认值"。
# 各区域实际上线的模型请去 Vertex AI → Model Garden 查。
GEMINI_IMAGE_MODEL=

# 域名（例如 ai-tool.yourdomain.com）
# 必须已经解析到 VM 的公网 IP
DOMAIN=

# Caddy 自动申请 HTTPS 证书时用的邮箱
# 填你能收邮件的邮箱，Let's Encrypt 会发送证书过期提醒
ADMIN_EMAIL=admin@example.com

# ==========================================
# Week 2 新增：账号登录相关
# ==========================================

# 会话加密密钥，至少 32 个字符
# 生成方法（在 SSH 终端里跑）：openssl rand -hex 32
# 这个值泄露后所有登录会话都会失效（需要重新登录），注意保密
SESSION_SECRET=

# 首次启动时自动创建的管理员账号（如果数据库里还没有任何用户）
# 建议先用强密码，登录后在"用户管理"页面改密码或加新成员
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
